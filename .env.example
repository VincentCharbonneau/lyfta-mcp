# Copy this file to .env (which git ignores) and fill in your values.
# Never put a real key in .env.example: it is committed to GitHub.

# Local stdio mode: your personal Lyfta API key (https://my.lyfta.app/community/api).
LYFTA_API_KEY=

# HTTP mode: no key is set on the server; every caller sends their own as a Bearer token.
# Optional: comma-separated SHA-256 hex digests of the keys this server accepts.
SERVER_ALLOWLIST_KEYS_SHA256=

LOG_LEVEL=INFO
# LYFTA_BASE_URL=https://my.lyfta.app
# PORT=8000
