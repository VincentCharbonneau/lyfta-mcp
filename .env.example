# Copy this file to .env (which git ignores) and fill in your values.
# Never put real secrets in .env.example: it is committed to GitHub.

# Your Lyfta API key (https://my.lyfta.app/community/api). It never leaves the server.
LYFTA_API_KEY=

# Access token clients must send as "Authorization: Bearer <token>". At least 24 characters.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

LOG_LEVEL=INFO
# LYFTA_BASE_URL=https://my.lyfta.app
# HOST=127.0.0.1
# PORT=8000
